# ===== Server =====
PORT=8080
DEV_MODE=development
NODE_ENV=development

# Frontend URL (OAuth redirect + reset-password links + CORS)
CLIENT_URL=http://localhost:3000

# ===== Database =====
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# ===== Google Gemini =====
GEMINI_API_KEY=<your-gemini-api-key>
# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated, tried in order after GEMINI_MODEL fails
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Must match the Atlas vector index dimension. If you change this, run:
#   node scripts/reembed.js --dry-run   (then without the flag)
EMBEDDING_DIMS=768

# ===== Rate limits =====
# AI endpoints (chat/stream/studio/openai): requests per 15 min per IP
AI_RATE_MAX=100

# ===== Observability =====
# pino log level (debug|info|warn|error). Pretty logs in dev, JSON in prod.
LOG_LEVEL=
# Comma-separated emails allowed to hit GET /api/v1/usage/admin
ADMIN_EMAILS=

# ===== Eval harness (npm run eval) =====
# Hard cap on Gemini API calls per eval run
EVAL_MAX_CALLS=120
# Pause between questions to respect free-tier RPM
EVAL_PACE_MS=1500
# Fail the run if a metric drops more than this vs evals/baseline.json
EVAL_REGRESSION_THRESHOLD=0.10
# Optional: separate DB for eval runs (default: MONGO_URI; `--memory` flag uses in-memory)
EVAL_MONGO_URI=
# Optional: override just the database name on the same cluster for Atlas eval runs
# (e.g. quantum_ai_eval while the app uses quantum_ai)
EVAL_MONGO_DB=

# ===== JWT =====
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=<strong-random-secret>
JWT_REFRESH_SECRET=<strong-random-secret>
JWT_ACCESS_EXPIREIN=24h
JWT_REFRESH_EXPIREIN=15d

# ===== OAuth =====
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-oauth-client-secret>

# ===== Email (Gmail app password) =====
SMTP_EMAIL=<your-gmail>
SMTP_PASSWORD=<gmail-app-password>
SMTP_FROM_NAME=Quantum AI

# ===== RAG tuning =====
RAG_TOP_K=3
RAG_MIN_SCORE=0.5
MAX_ATTACH_CHARS=12000
ATLAS_VECTOR_SEARCH_INDEX=chunks_embedding_index
# Skip boot-time Atlas Search index creation — for throwaway/verification
# databases only (the real deployment must keep it enabled).
SKIP_INDEX_ENSURE=

# ===== Retrieval quality (Phase 4) =====
# Candidates fetched per leg before RRF fusion
RAG_CANDIDATES=20
# Reciprocal Rank Fusion constant
RAG_RRF_K=60
# Hybrid vector+keyword retrieval. Measured: ties vector-only on the stress
# set (see DECISIONS.md) — default OFF, opt-in per deployment.
RAG_HYBRID=false
# Keyword-leg admission: minimum Mongo textScore (~0.58/matched term; 3 ≈ 5+
# terms) and the keyword leg's RRF weight (rescue leg, not a re-ranker)
RAG_KEYWORD_MIN_SCORE=3
RAG_KEYWORD_WEIGHT=0.5
# Optional LLM rerank of the top fused candidates — costs 1 generate call per
# query, adds ~400ms; no measured MRR gain, default OFF
RAG_RERANK=false
RAG_RERANK_CANDIDATES=15
RAG_RERANK_TIMEOUT_MS=4000
# Rewrite context-dependent follow-ups into standalone queries for retrieval
# (never touches the stored message). Measured +0.045 MRR overall — default ON.
RAG_REWRITE=true

# ===== AI budget (Phase 5.0d) =====
# Cheap-lane model for titles/summaries/rewrites/memory/rerank/quiz grading.
# Default: the configured *-lite fallback. Verified via listModels at boot;
# when exhausted or missing, cheap calls fall through the normal model chain.
GEMINI_CHEAP_MODEL=
# Per-user daily AI requests (chat counts once per message, an agent run
# counts once). 0 = disabled. ADMIN_EMAILS accounts are exempt.
USER_DAILY_AI_CAP=60

# ===== Global search (Phase 4.5) =====
# Cap on user chats scanned per Smart search request
SEARCH_MAX_CHATS=500
# Chat summary refresh interval (messages since last summary)
SUMMARY_REFRESH_EVERY=10
# Pace between chats for scripts/backfill-chat-summaries.js
BACKFILL_PACE_MS=2000

# ===== Agent mode =====
# Master switch — when "false", mode:"agent" is rejected and the UI hides the switch
FEATURE_AGENT=true
# Loop limits: model->tools rounds, wall-clock ms, tool calls per round
AGENT_MAX_STEPS=5
AGENT_TIMEOUT_MS=45000
AGENT_MAX_TOOLS_PER_STEP=3
# Per-user daily cap for the web_search tool (Google Search grounding)
WEB_SEARCH_DAILY_CAP=20

# ===== Ingestion pipeline (Phase 3A) =====
# "true" runs ingestion synchronously inside the upload request (tests, small files).
# Default (unset) queues a job and returns 202 {fileId, jobId}.
INGEST_SYNC=
# In-process job runner tuning
INGEST_CONCURRENCY=1
INGEST_POLL_MS=3000
# processing jobs with a lock older than this are requeued at boot
INGEST_STALE_MS=120000
INGEST_MAX_ATTEMPTS=3
# chunks embedded per batch (exponential backoff on 429/5xx)
INGEST_EMBED_BATCH=8
# Per-user total storage cap in MB (M0 has 512MB total)
USER_STORAGE_MAX_MB=100

# ===== Audio ingestion =====
FEATURE_AUDIO=true
AUDIO_MAX_MB=25
AUDIO_MAX_MIN=30
# Buffers above this go through the Gemini Files API instead of inline parts
AUDIO_INLINE_MAX_MB=10
# Long audio is transcribed in windows of this many seconds (resumable per window)
AUDIO_SEGMENT_SEC=600
# Optional dedicated transcription model — verified via listModels at boot;
# falls back to GEMINI_MODEL when missing or unsupported
GEMINI_TRANSCRIBE_MODEL=

# ===== Multimodal (Phase 3B.2/3.3) =====
# Covers image ingestion + PDF deep analysis
FEATURE_MULTIMODAL=true
IMAGE_MAX_MB=8
# Vision model for image description / PDF page analysis (falls back to GEMINI_MODEL)
GEMINI_VISION_MODEL=
# PDF deep analysis caps: pages per run, runs per user per day, pages per window
MULTIMODAL_MAX_PAGES=20
DEEP_ANALYSIS_DAILY_CAP=3
DEEP_ANALYSIS_WINDOW_PAGES=5
# Pages with fewer extractable characters than this are flagged "scanned"
# (File.pagesWithoutText) and offered Deep analysis in the UI
PDF_MIN_PAGE_CHARS=30

# ===== CSV table analyst (Phase 3B.4) =====
TABLE_MAX_ROWS=50000
TABLE_QUERY_TIMEOUT_MS=10000

# ===== Long-term memory (Phase 5.1) =====
# Per-user memory cap; at capacity the least-recently-used memory is evicted
MEMORY_MAX=200
# Extraction runs at most every Nth user turn, gated by a local heuristic
MEMORY_EVERY_N_TURNS=6
# Retrieval: top-K memories injected, minimum cosine score
MEMORY_TOP_K=3
MEMORY_MIN_SCORE=0.55
# Cosine above this merges the new item into the existing memory
MEMORY_DEDUPE_THRESHOLD=0.9
# Default for the per-user memoryEnabled flag
MEMORY_DEFAULT_ON=true

# ===== Study mode (Phase 5.2) =====
# Total cards per user across all decks
STUDY_MAX_CARDS=2000
# Max questions per generated quiz. (ReviewLog TTL is fixed at 1 year in the
# model — MongoDB builds TTL indexes once at creation.)
QUIZ_MAX_Q=10

# ===== Public API keys (Phase 5.4) =====
# Max active keys per user
API_KEY_MAX_ACTIVE=5
# Per-key daily request cap (also counts toward the owner's USER_DAILY_AI_CAP)
API_KEY_DAILY_CAP=100
# Per-key rate limit (requests per 15 minutes)
API_KEY_RATE_MAX=30

# ===== Multi-provider LLM layer (Phase 6A) =====
# Providers considered, in preference order. Only providers with a key are
# enabled; groq/openrouter entries are ignored when their keys are absent.
LLM_PROVIDERS=gemini,groq,openrouter
# Privacy gate: restricts which providers may receive user content. Empty =
# all enabled providers. e.g. "gemini" pins all traffic to Google.
LLM_ALLOWED_PROVIDERS=
# Optional OpenAI-compatible providers (verified at runtime via their
# model-list endpoints; unverified model defaults — run scripts/llm-smoke.js
# after configuring to confirm the models you name exist on your account).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Per-task provider chains — comma lists of provider:model tried in order.
# UNSET = derive from GEMINI_MODEL/GEMINI_FALLBACK_MODELS (pre-Phase-6
# behavior). Example multi-provider chain (model names are UNVERIFIED
# placeholders — check each provider's model list before deploying):
#   LLM_CHAIN_ANSWER=gemini:gemini-2.5-flash,groq:llama-3.3-70b-versatile
LLM_CHAIN_ANSWER=
LLM_CHAIN_CHEAP=
LLM_CHAIN_AGENT=
LLM_CHAIN_VISION=
LLM_CHAIN_TRANSCRIBE=
LLM_CHAIN_JUDGE=
# Provider-request timeout and circuit-breaker cooldown for daily/quota
# exhaustion when the provider doesn't report a reset time (default 6h).
LLM_REQUEST_TIMEOUT_MS=60000
LLM_DAILY_COOLDOWN_MS=21600000
# Dev/eval disk response cache — deterministic calls only, NEVER production
# (the router refuses to enable it when NODE_ENV=production).
LLM_CACHE=
LLM_CACHE_DIR=.cache/llm
LLM_CACHE_TTL_MS=604800000
LLM_CACHE_MAX=500

# ===== Demo mode (Phase 6.4) =====
# Portfolio mode: enables POST /api/v1/auth/demo (a seeded, restricted demo
# account) and GET /api/v1/demo/replay/* recorded streams. Default OFF.
DEMO_MODE=false
# Demo account identity + tighter daily AI budget than USER_DAILY_AI_CAP
DEMO_USER_EMAIL=demo@quantum.local
DEMO_DAILY_AI_CAP=20
# Token-event pacing for recorded replays (ms)
DEMO_REPLAY_PACE_MS=90
